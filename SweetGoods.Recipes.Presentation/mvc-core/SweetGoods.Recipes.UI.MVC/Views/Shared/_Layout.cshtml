<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sweet Goods</title>

    <link href="~/vendor.min.css" rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark fixed-top navbar-expand-md">
        <div class="container">
            <button type="button" class="navbar-toggler" data-toggle="collapse" data-target=".navbar-collapse">
                <span class="sr-only">Toggle navigation</span>
                &#x2630;
            </button> <a asp-controller="Home" asp-action="Index" class="navbar-brand">Sweet Goods</a>
            <div class="navbar-collapse collapse">
                <ul class="nav navbar-nav">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">Página Inicial</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Recipe" asp-action="Index" class="nav-link">Receitas</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Ingredient" asp-action="Index" class="nav-link">Ingredientes</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr>
        <footer>
            <p>&#xA9; 2018 - Sweet Goods</p>
        </footer>
    </div>

    <script src="~/vendor.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>